# 바이브코딩 전시 백엔드 환경 변수
# 로컬에서는 이 파일을 복사해서 .env 로 만들어 채워주세요.
# Render 배포 시에는 Render 대시보드의 Environment 탭에 같은 값들을 넣습니다.

# 서버 포트 (Render는 자동으로 PORT 환경변수를 제공합니다)
PORT=8080

# Supabase 설정 (기존 프로젝트 재사용)
SUPABASE_URL=https://sksvygodhnlcrznfuklr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# CORS 허용 도메인 (쉼표로 구분, * 면 모두 허용)
CORS_ORIGIN=*
